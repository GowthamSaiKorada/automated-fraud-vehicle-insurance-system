# ==============================================================================
# Vehicle Insurance Fraud Detection System - Environment Configuration Example
# ==============================================================================

# --- Backend (Node.js / Express) ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/vehicle_insurance_fraud
# Set to "true" to automatically fall back to an in-memory MongoDB instance
# (mongodb-memory-server) if local MongoDB is unreachable during development/testing
USE_MEMORY_DB_FALLBACK=true
JWT_SECRET=replace_with_a_strong_random_secret_key_min_32_chars
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
CORS_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://127.0.0.1:8000

# --- AI Service (Python / FastAPI) ---
AI_HOST=127.0.0.1
AI_PORT=8000
# Path to trained PyTorch CNN checkpoint (.pth / .pt). Leave empty to run in explicit Demo Mode.
CNN_MODEL_PATH=
# Optional path to YOLO weights (.pt) for /detect-damage. Leave empty if unavailable.
YOLO_MODEL_PATH=
# Explicitly control demo mode behavior (true/false). Automatically active if CNN_MODEL_PATH is unset/missing.
AI_DEMO_MODE=true

# --- Frontend (React / Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api
